        medo: 3
        emp: 0
        desc: 1
        cons: 0
        apat: 0
      value: 1.6
      livraria: 0
    - id: 
      category: 0
      text: "Mais um assalto ao multibanco da esquina. Onde est\xE1 a pol\xEDcia?"
