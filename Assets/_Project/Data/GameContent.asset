  content:
    pool:
    - id: 
      category: 0
      text: "Viram aquele carro preto parado na Rua das Flores h\xE1 tr\xEAs dias? Ningu\xE9m sabe de quem \xE9."
      author: 
      effects:
        medo: 2
        emp: 0
        desc: 1
        cons: 0
        apat: 0
      value: 1.4
      livraria: 0
    - id: 
      category: 0
      text: "Dizem que as rendas v\xE3o subir no bairro todo. Preparem-se."
      author: 
      effects:
        medo: 2
        emp: 0
        desc: 2
        cons: 0
        apat: 0
      value: 1.5
      livraria: 0
    - id: 
      category: 0
      text: "A \xE1gua da fonte da pra\xE7a est\xE1 contaminada? Algu\xE9m confirma?"
