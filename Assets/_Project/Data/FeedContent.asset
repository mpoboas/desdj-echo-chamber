    dialogue:
      days:
      - day: 1
        title: Dia 1
        subtitle: Primeiro dia de trabalho
        pre:
        - speaker: Sara
          text: "Ol\xE1! Sou a Sara, trabalho aqui ao lado. Primeiro dia, n\xE3o \xE9?"
        - speaker: Sara
          text: "\xC9 f\xE1cil: chega-te um post, arrastas para o telem\xF3vel de quem quiseres. Clica num vizinho \xE0 esquerda para o veres de perto."
        - speaker: Sara
          text: "Vai tocar o telefone. \xC9 o Dr. Valente. Atende sempre."
        call:
        - speaker: Dr. Valente
          text: "Bom dia! Dr. Valente. Hoje o objetivo s\xE3o {goal} minutos de tempo na app. Simples, n\xE3o \xE9?"
      - day: 2
        title: Dia 2
        subtitle: "Mais uma manh\xE3"
        pre: []
        call:
        - speaker: Dr. Valente
          text: 'Ontem correu bem. Hoje subimos a fasquia: {goal} minutos. E temos uma nova utilizadora, a Leonor.'
        - speaker: Sara
          text: "Ouvi dizer que as pol\xE9micas rendem. N\xE3o fui eu que disse."
      - day: 3
        title: Dia 3
        subtitle: Um dia diferente
        pre: []
        call:
        - speaker: Dr. Valente
          text: 'Meta de hoje: {goal} minutos. Ah, mandei abrir os estores, isto estava muito escuro.'
        - speaker: Sara
          text: "Agora podes ver a rua. Eu n\xE3o olharia demasiado."
      - day: 4
        title: Dia 4
        subtitle: Segunda metade da semana
        pre: []
        call:
        - speaker: Dr. Valente
          text: '{goal} minutos. O Hugo entra hoje. Preciso de mais, e sem desculpas.'
      - day: 5
        title: Dia 5
        subtitle: "\xDAltimo dia"
        pre: []
        call:
        - speaker: Dr. Valente
          text: "\xDAltimo dia. {goal} minutos. Sei que consegue."
      met:
      - speaker: Dr. Valente
