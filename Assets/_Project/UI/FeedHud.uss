/* Screen-space HUD: phone calls, day card, end-of-day summary. Reference 1920x1080. */
.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-chip { position: absolute; left: 50%; bottom: 46px; width: 460px; margin-left: -230px; padding: 16px 24px; flex-direction: row; justify-content: center; align-items: center; background-color: #ffb547; border-radius: 99px; opacity: 0; translate: 0 40px; transition-property: opacity, translate; transition-duration: 0.3s; display: none; }
.hud-chip--on { display: flex; opacity: 1; translate: 0 0; }
.hud-chip-text { font-size: 20px; color: #1a1305; -unity-font-style: bold; }
.hud-chip-go { font-size: 20px; color: #1a1305; -unity-font-style: bold; margin-left: 12px; padding: 4px 14px; background-color: rgba(26,19,5,0.12); border-radius: 99px; }
.hud-sub { position: absolute; left: 50%; bottom: 46px; width: 1040px; margin-left: -520px; padding: 22px 30px; background-color: #0b0d14; border-radius: 18px; border-width: 1px; border-color: #262b3d; display: none; }
.hud-sub--on { display: flex; }
.hud-who { font-size: 14px; letter-spacing: 3px; color: #ffb547; -unity-font-style: bold; margin-bottom: 10px; }
.hud-text { font-size: 26px; color: #f3f4fa; white-space: normal; min-height: 72px; }
.hud-go { font-size: 14px; color: #7d86a1; -unity-text-align: middle-right; margin-top: 8px; }
.hud-card { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #07070a; align-items: center; justify-content: center; opacity: 0; display: none; transition-property: opacity; transition-duration: 0.6s; }
.hud-card--show { display: flex; }
.hud-card--on { opacity: 1; }
.hud-card-title { font-size: 76px; color: #eceff7; -unity-font-style: bold; letter-spacing: 4px; }
.hud-card-sub { font-size: 24px; color: #8b93ab; margin-top: 16px; }
.hud-summary { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(7,7,10,0.8); align-items: center; justify-content: center; display: none; }
.hud-summary--on { display: flex; }
.hud-panel { width: 700px; padding: 38px 44px; background-color: #f1ece0; border-radius: 20px; }
.hud-panel-title { font-size: 40px; color: #1e2333; -unity-font-style: bold; }
.hud-panel-body { font-size: 20px; color: #3b4258; margin-top: 10px; white-space: normal; }
.hud-warns { flex-direction: row; margin-top: 20px; }
.hud-warn { width: 38px; height: 12px; border-radius: 99px; background-color: #d9d1bd; margin-right: 8px; }
.hud-warn--on { background-color: #c0392b; }
.hud-btn { margin-top: 26px; align-self: flex-start; padding: 14px 28px; background-color: #1e2333; border-radius: 12px; }
.hud-btn-text { font-size: 18px; color: #f1ece0; -unity-font-style: bold; }
