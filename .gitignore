# =============================================================================
# Unity .gitignore
# Notes:
#   - Keep every .meta file under version control (GUID references break without them).
#   - Keep Packages/manifest.json, Packages/packages-lock.json and ProjectSettings/.
#   - Requires Edit > Project Settings > Editor > Asset Serialization = Force Text
#     and Version Control Mode = Visible Meta Files.
# =============================================================================

# -----------------------------------------------------------------------------
# Unity generated folders
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment if you use Collab/Plastic and want to exclude the local cache
# /[Aa]ssets/Plugins/Editor/JetBrains*

# -----------------------------------------------------------------------------
# Unity auto-generated assets and caches
# -----------------------------------------------------------------------------
# Autogenerated by Unity when entering play mode / building
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables build output
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Ss]erverData/
/[Aa]ssets/[Ss]treamingAssets/[Aa]ddressables_content_state.bin*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
crashlytics-build.properties

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Code coverage / test results
/[Cc]ode[Cc]overage/
TestResult*.xml
InitTestScene*.unity*

# Burst / Shader / IL2CPP caches
*_BurstDebugInformation_DoNotShip*
*_BackUpThisFolder_ButDontShipItWithYourGame*
*_BackUpThisFolder_ButDontShipItWithYourGame.meta
/[Aa]ssets/[Ss]treamingAssets/burst/
/[Aa]ssets/[Ss]treamingAssets/burst.meta

# Plastic SCM / Collab leftovers
.plastic/
plastic.workspace
plastic.selector
plastic.wktree
.collabignore
.collabignore.meta

# Unity Cloud / Services
/[Aa]ssets/Plugins/Editor/Unity*Services*/

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.ipa
*.xcarchive
*.dSYM/
*.dSYM.zip
*.symbols.zip
*.symbols
*.map

# Android Studio export
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# iOS / Xcode generated
*.xcuserstate
xcuserdata/
DerivedData/
Pods/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# -----------------------------------------------------------------------------
# Secrets and local config (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.p12
*.pfx
*.secret
secrets.json
*.keystore.properties

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
# JetBrains Rider
.idea/
*.sln.iml
*.iml

# Visual Studio Code (keep shared workspace config if you want it tracked)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Visual Studio
*.DotSettings.user
*.ncrunch*
_ReSharper*/
*.[Rr]e[Ss]harper

# MonoDevelop
*.userprefs

# Sublime / Vim / Emacs
*.sublime-workspace
*.swp
*.swo
*~
\#*\#
.#*

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.DocumentRevisions-V100
Icon[\r]

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Tooling and misc
# -----------------------------------------------------------------------------
# Claude Code local settings
.claude/settings.local.json

# Node / npm (editor tooling, UPM scoped registries tooling, etc.)
node_modules/
npm-debug.log*

# Python (helper scripts)
__pycache__/
*.pyc
.venv/

# Local logs and crash dumps
*.log
*.dmp
*.stackdump

# Backups
*.bak
*.orig
*.rej

# Screenshots saved by the MCP game_view tool (relative to Assets/)
/[Aa]ssets/Temp/
/[Aa]ssets/Temp.meta
